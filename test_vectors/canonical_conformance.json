{
  "version": "1.0",
  "description": "Provara RFC 8785 Canonical JSON Conformance Suite",
  "vectors": [
    {
      "id": "key_ordering_01",
      "description": "Basic lexicographic key sorting",
      "input": {
        "z": 1,
        "a": 2,
        "m": 3
      },
      "expected_hex": "7b2261223a322c226d223a332c227a223a317d"
    },
    {
      "id": "key_ordering_unicode",
      "description": "Unicode key sorting (code point order)",
      "input": {
        "\u00a3": 1,
        "a": 2,
        "\u20ac": 3,
        "z": 4
      },
      "expected_hex": "7b2261223a322c227a223a342c22c2a3223a312c22e282ac223a337d"
    },
    {
      "id": "empty_containers_01",
      "description": "Empty object and array are preserved",
      "input": {
        "empty_obj": {},
        "empty_arr": []
      },
      "expected_hex": "7b22656d7074795f617272223a5b5d2c22656d7074795f6f626a223a7b7d7d"
    },
    {
      "id": "nested_structure_01",
      "description": "Deeply nested objects and arrays",
      "input": {
        "a": [
          1,
          {
            "b": 2
          },
          [
            3,
            4
          ]
        ],
        "c": {
          "d": {
            "e": 5
          }
        }
      },
      "expected_hex": "7b2261223a5b312c7b2262223a327d2c5b332c345d5d2c2263223a7b2264223a7b2265223a357d7d7d"
    },
    {
      "id": "null_handling_01",
      "description": "Null values MUST be preserved",
      "input": {
        "a": null,
        "b": {
          "c": null
        }
      },
      "expected_hex": "7b2261223a6e756c6c2c2262223a7b2263223a6e756c6c7d7d"
    },
    {
      "id": "string_escapes_01",
      "description": "Minimal escapes in strings",
      "input": {
        "s": "quote: \", backslash: \\, tab: \t, newline: \n"
      },
      "expected_hex": "7b2273223a2271756f74653a205c222c206261636b736c6173683a205c5c2c207461623a205c742c206e65776c696e653a205c6e227d"
    },
    {
      "id": "unicode_string_distinct_01",
      "description": "NFC and NFD strings stay byte-distinct",
      "input": {
        "nfc": "\u00e9",
        "nfd": "e\u0301"
      },
      "expected_hex": "7b226e6663223a22c3a9222c226e6664223a2265cc81227d"
    },
    {
      "id": "number_formatting_01",
      "description": "Finite numbers in canonical JSON encoding",
      "input": {
        "int": 10,
        "neg_int": -7,
        "frac": 0.125,
        "big": 1000000.5
      },
      "expected_hex": "7b22626967223a313030303030302e352c2266726163223a302e3132352c22696e74223a31302c226e65675f696e74223a2d377d"
    },
    {
      "id": "number_formatting_minus_zero",
      "description": "Minus zero preserved by current Python canonicalizer",
      "input": {
        "minus_zero": -0.0,
        "zero": 0.0
      },
      "expected_hex": "7b226d696e75735f7a65726f223a2d302e302c227a65726f223a302e307d"
    },
    {
      "id": "array_mixed_types_01",
      "description": "Mixed JSON primitives in array order",
      "input": {
        "arr": [
          null,
          true,
          false,
          0,
          "x",
          {
            "k": "v"
          }
        ]
      },
      "expected_hex": "7b22617272223a5b6e756c6c2c747275652c66616c73652c302c2278222c7b226b223a2276227d5d7d"
    },
    {
      "id": "key_prefix_order_01",
      "description": "Key ordering with shared prefixes",
      "input": {
        "a": 1,
        "a0": 2,
        "a_": 3,
        "aa": 4
      },
      "expected_hex": "7b2261223a312c226130223a322c22615f223a332c226161223a347d"
    },
    {
      "id": "boolean_and_null_01",
      "description": "Boolean and null fields canonicalization",
      "input": {
        "t": true,
        "f": false,
        "n": null
      },
      "expected_hex": "7b2266223a66616c73652c226e223a6e756c6c2c2274223a747275657d"
    },
    {
      "id": "float_int_distinction_01",
      "description": "PV-001: Float 1.0 vs integer 1 produce different canonical bytes",
      "input": {
        "float_val": 1.0,
        "int_val": 1
      },
      "expected_hex": "7b22666c6f61745f76616c223a312e302c22696e745f76616c223a317d"
    },
    {
      "id": "float_zero_variants_01",
      "description": "PV-001: Positive zero (0.0) vs integer zero (0) distinction",
      "input": {
        "float_zero": 0.0,
        "int_zero": 0
      },
      "expected_hex": "7b22666c6f61745f7a65726f223a302e302c22696e745f7a65726f223a307d"
    },
    {
      "id": "number_scientific_01",
      "description": "PV-001: Numbers that trigger scientific notation in some languages",
      "input": {
        "small": 0.00000001,
        "large": 100000000.0
      },
      "expected_hex": "7b226c61726765223a3130303030303030302e302c22736d616c6c223a31652d30387d"
    },
    {
      "id": "js_precision_boundary_01",
      "description": "PV-001: Integer at JS Number.MAX_SAFE_INTEGER boundary",
      "input": {
        "safe": 9007199254740991,
        "unsafe": 9007199254740993
      },
      "expected_hex": "7b2273616665223a393030373139393235343734303939312c22756e73616665223a393030373139393235343734303939337d"
    },
    {
      "id": "nested_float_payload_01",
      "description": "PV-001: Float values nested in event-like payload structure",
      "input": {
        "payload": {
          "confidence": 0.95,
          "count": 1.0,
          "severity": 3
        },
        "type": "OBSERVATION"
      },
      "expected_hex": "7b227061796c6f6164223a7b22636f6e666964656e6365223a302e39352c22636f756e74223a312e302c227365766572697479223a337d2c2274797065223a224f42534552564154494f4e227d"
    },
    {
      "id": "empty_payload_01",
      "description": "PV-001: Empty payload object in event structure",
      "input": {
        "payload": {},
        "prev_event_hash": null,
        "type": "GENESIS"
      },
      "expected_hex": "7b227061796c6f6164223a7b7d2c22707265765f6576656e745f68617368223a6e756c6c2c2274797065223a2247454e45534953227d"
    },
    {
      "id": "timestamp_string_01",
      "description": "PV-001: ISO 8601 timestamps with varying precision",
      "input": {
        "ts_millis": "2026-03-18T03:30:00.000Z",
        "ts_micros": "2026-03-18T03:30:00.000000Z",
        "ts_bare": "2026-03-18T03:30:00Z"
      },
      "expected_hex": "7b2274735f62617265223a22323032362d30332d31385430333a33303a30305a222c2274735f6d6963726f73223a22323032362d30332d31385430333a33303a30302e3030303030305a222c2274735f6d696c6c6973223a22323032362d30332d31385430333a33303a30302e3030305a227d"
    },
    {
      "id": "unicode_payload_01",
      "description": "PV-001: Unicode values in realistic payload",
      "input": {
        "actor": "agent_\u03b1",
        "message": "\u2714 verified",
        "tag": "\u6d4b\u8bd5"
      },
      "expected_hex": "7b226163746f72223a226167656e745fceb1222c226d657373616765223a22e29c94207665726966696564222c22746167223a22e6b58be8af95227d"
    },
    {
      "id": "deep_mixed_01",
      "description": "PV-001: Deep nesting with all JSON types",
      "input": {
        "a": {
          "b": {
            "c": [1, 2.0, "3", null, true, false, {"d": []}]
          }
        }
      },
      "expected_hex": "7b2261223a7b2262223a7b2263223a5b312c322e302c2233222c6e756c6c2c747275652c66616c73652c7b2264223a5b5d7d5d7d7d7d"
    }
  ]
}
