{
  "name": "provara-hosted-vault",
  "version": "0.1.0",
  "description": "Provara Hosted Vault MVP - Managed tamper-evident event logging",
  "private": true,
  "scripts": {
    "dev": "vercel dev",
    "build": "echo 'Python API - no build needed'",
    "deploy": "vercel --prod",
    "db:migrate": "supabase db push",
    "db:seed": "tsx src/scripts/seed.ts",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest"
  },
  "dependencies": {
    "@clerk/backend": "^1.0.0",
    "@sentry/node": "^8.0.0",
    "@supabase/supabase-js": "^2.39.0",
    "@vercel/kv": "^2.0.0",
    "stripe": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "supabase": "^1.142.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vercel": "^34.0.0",
    "vitest": "^1.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Hunt Information Systems LLC",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/provara-protocol/provara.git",
    "directory": "hosted-vault"
  }
}
