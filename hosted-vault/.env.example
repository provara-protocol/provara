# Provara Hosted Vault - Environment Variables

# =============================================================================
# CLERK AUTHENTICATION
# =============================================================================
# Get from: https://dashboard.clerk.com > API Keys
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_JWT_ISSUER=https://your-instance.clerk.accounts.dev

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Get from: https://app.supabase.com > Settings > API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...  # Service role (keep secret!)
SUPABASE_ANON_KEY=eyJhbGc...  # Anon key for client-side

# Storage bucket name for vault files
SUPABASE_VAULTS_BUCKET=vaults

# =============================================================================
# STRIPE BILLING
# =============================================================================
# Get from: https://dashboard.stripe.com > Developers > API keys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Product/Price IDs (create in Stripe Dashboard)
STRIPE_PRODUCT_DEVELOPER=prod_xxx
STRIPE_PRICE_DEVELOPER_MONTHLY=price_xxx
STRIPE_PRODUCT_TEAM=prod_xxx
STRIPE_PRICE_TEAM_MONTHLY=price_xxx

# =============================================================================
# SENTRY MONITORING (Optional)
# =============================================================================
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ENVIRONMENT=production

# =============================================================================
# RATE LIMITING (Vercel KV - Optional)
# =============================================================================
KV_REST_API_URL=https://xxx.upstash.io
KV_REST_API_TOKEN=xxxxx

# =============================================================================
# GENERAL
# =============================================================================
NODE_ENV=production
LOG_LEVEL=info

# Vault storage settings
MAX_EVENT_PAYLOAD_BYTES=10240  # 10KB per event
DEFAULT_VAULT_TIER=free
